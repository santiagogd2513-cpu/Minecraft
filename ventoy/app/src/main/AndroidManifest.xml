<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- para instalar sus propias actualizaciones -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ventoy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <!-- al conectar una memoria USB, Android ofrece abrir la app -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_storage" />
        </activity>

        <!-- el ícono de la app en el inicio: uno por temporada, solo uno prendido (Icons.java) -->
        <activity-alias
            android:name=".Inicio"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".InicioNavidad"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_navidad"
            android:roundIcon="@mipmap/ic_launcher_navidad"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".InicioVelitas"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_velitas"
            android:roundIcon="@mipmap/ic_launcher_velitas"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".InicioValentin"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_valentin"
            android:roundIcon="@mipmap/ic_launcher_valentin"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".InicioAmistad"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amistad"
            android:roundIcon="@mipmap/ic_launcher_amistad"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
