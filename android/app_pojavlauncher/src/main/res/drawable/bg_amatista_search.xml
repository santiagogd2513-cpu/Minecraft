<?xml version="1.0" encoding="utf-8"?>
<!-- Amatista: barra de búsqueda en forma de píldora -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A1A40" />
            <stroke android:width="2dp" android:color="#B57BFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22152F" />
            <stroke android:width="1dp" android:color="#5A3F86" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
