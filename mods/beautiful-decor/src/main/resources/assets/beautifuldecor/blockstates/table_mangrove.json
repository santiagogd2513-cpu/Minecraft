{
  "multipart": [
    {
      "apply": {
        "model": "beautifuldecor:block/table_mangrove_top"
      }
    },
    {
      "when": {
        "AND": [
          {
            "north": "false"
          },
          {
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "beautifuldecor:block/table_mangrove_leg_nw"
      }
    },
    {
      "when": {
        "AND": [
          {
            "north": "false"
          },
          {
            "east": "false"
          }
        ]
      },
      "apply": {
        "model": "beautifuldecor:block/table_mangrove_leg_ne"
      }
    },
    {
      "when": {
        "AND": [
          {
            "south": "false"
          },
          {
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "beautifuldecor:block/table_mangrove_leg_sw"
      }
    },
    {
      "when": {
        "AND": [
          {
            "south": "false"
          },
          {
            "east": "false"
          }
        ]
      },
      "apply": {
        "model": "beautifuldecor:block/table_mangrove_leg_se"
