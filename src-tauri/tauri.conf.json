{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amatista Launcher",
  "version": "1.0.0",
  "identifier": "com.amatista.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Amatista Launcher",
        "width": 1180,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#120d1f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    }
  }
}
